---
import { educationEntries } from '../data/portfolio';
---
<section>
  <div class="flex flex-col gap-6">
    {educationEntries.map((entry) => (
      <div class="border-b border-neutral-800 pb-4">
        <div class="flex flex-col md:flex-row md:items-baseline md:justify-between mb-1">
          <h3 class="font-medium text-lg text-neutral-100">{entry.degree}</h3>
          <span class="text-sm text-neutral-300 tabular-nums">{entry.year}</span>
        </div>
        <p class="text-neutral-300 mb-2">{entry.school}</p>
        <p class="text-neutral-300 mb-2">{entry.description}</p>
        {entry.links && <div class="flex flex-row gap-4">
          {entry.links.map((link) => <a href={link.url} class="underline text-neutral-300 hover:opacity-80 interactive-soft" target="_blank" rel="noopener noreferrer">{link.label}</a>)}
        </div>}
      </div>
    ))}
  </div>
</section>
