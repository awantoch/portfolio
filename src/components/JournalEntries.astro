---
import { getJournalPosts } from '../lib/journal';
import { formatDate } from '../lib/utils';
interface Props { limit?: number; showMore?: boolean }
const { limit, showMore = false } = Astro.props;
const allEntries = await getJournalPosts();
const entries = limit ? allEntries.slice(0, limit) : allEntries;
---
<div>
  <ul class="space-y-4">
    {entries.map((post) => (
      <li>
        <a href={`/journal/${post.slug}`} class="block card-base card-base--dark p-4 space-y-2 group interactive">
          <div class="flex flex-col space-y-1">
            <div class="flex flex-row items-baseline gap-x-2">
              <p class="hidden md:block text-neutral-400 min-w-[120px] whitespace-nowrap tabular-nums">{formatDate(post.metadata.publishedAt, false)}</p>
              <div>
                <p class="text-neutral-100 tracking-tight font-semibold">{post.metadata.title}</p>
                {post.metadata.summary && <p class="text-sm text-neutral-400">{post.metadata.summary}</p>}
              </div>
            </div>
          </div>
        </a>
      </li>
    ))}
  </ul>
  {showMore && <div class="mt-8"><a href="/journal" class="underline text-neutral-300 hover:opacity-80 interactive-soft">View all entries →</a></div>}
</div>
