---
import { portfolioEntries } from '../data/portfolio';
interface Props { limit?: number; showMore?: boolean }
const { limit, showMore = false } = Astro.props;
const entries = limit ? portfolioEntries.slice(0, limit) : portfolioEntries;
---
<section>
  <div class="flex flex-col gap-6">
    {entries.map((entry) => (
      <div class="border-b border-neutral-800 pb-4">
        <h2 class="text-neutral-300 mb-2 font-medium">{entry.company}</h2>
        {entry.roles.map((role, index) => (
          <div class={index > 0 ? 'mt-3' : ''}>
            <div class="flex flex-col md:flex-row md:items-baseline md:justify-between mb-1">
              <h3 class="font-medium text-lg text-neutral-100">{role.title}</h3>
              <span class="text-sm text-neutral-300 tabular-nums">{role.dateRange}</span>
            </div>
            <p class="text-neutral-300 mb-2">{role.description}</p>
          </div>
        ))}
        {entry.links && <div class="flex flex-row gap-4 mt-2">
          {entry.links.map((link) => <a href={link.url} class="underline text-neutral-300 hover:opacity-80 interactive-soft" target="_blank" rel="noopener noreferrer">{link.label}</a>)}
        </div>}
      </div>
    ))}
  </div>
  {showMore && <div class="mt-8"><a href="/portfolio" class="underline text-neutral-300 hover:opacity-80 interactive-soft">View full portfolio →</a></div>}
</section>
