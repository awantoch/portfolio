---
import type { HTMLTag } from 'astro/types';
import { SITE_CONFIG } from '../../../lib/constants';
export interface Props { as: HTMLTag; [key: string]: unknown }
const { as: Tag, className, style, ...attributes } = Astro.props;
const styles: Record<string, string> = {
  h1: 'font-size:2.25rem;font-weight:700;margin:32px 0 16px;color:#fff;letter-spacing:-0.025em',
  h2: 'font-size:1.5rem;font-weight:600;margin:28px 0 12px;color:#fff;letter-spacing:-0.025em',
  h3: 'font-size:1.25rem;font-weight:600;margin:24px 0 10px;color:#fff;letter-spacing:-0.025em',
  h4: 'font-size:1.125rem;font-weight:600;margin:20px 0 8px;color:#fff;letter-spacing:-0.015em',
  h5: 'font-size:1rem;font-weight:600;margin:18px 0 6px;color:#fff',
  h6: 'font-size:0.875rem;font-weight:600;margin:16px 0 4px;color:#fff',
  p: 'font-size:1rem;line-height:1.6;margin:16px 0;color:#fff',
  a: 'color:#fff;text-decoration:underline;text-decoration-color:#fff;text-underline-offset:2px;text-decoration-thickness:1px',
  img: 'max-width:100%;height:auto;display:block;margin:0 auto 16px',
  pre: 'background:#18181b;color:#e5e7eb;padding:12px 16px;border:1px solid #27272a;border-radius:8px;overflow-x:auto;margin:18px 0;font-family:monospace;font-size:15px;line-height:1.6;white-space:pre-wrap;word-break:break-word',
  code: 'background:#282a36;color:#fff;padding:2px 6px;border-radius:6px;font-family:monospace;font-size:0.95em',
  table: 'border-collapse:collapse;width:100%;margin:18px 0;color:#fff',
  th: 'border:1px solid #444;padding:8px;background:#232136;color:#fff;font-weight:600',
  td: 'border:1px solid #444;padding:8px;color:#fff',
  blockquote: 'border-left:4px solid #6b7280;padding-left:1em;font-style:italic;color:#a3a3a3;margin:16px 0',
  ul: 'list-style-type:disc;padding-left:1.5em;color:#fff;margin:16px 0',
  ol: 'list-style-type:decimal;padding-left:1.5em;color:#fff;margin:16px 0',
  li: 'margin-bottom:6px',
  strong: 'font-weight:600',
};
const codeClass = String(className || attributes.class || '');
const inlineStyle = Tag === 'code' && codeClass.startsWith('language-') ? '' : styles[Tag];
if (Tag === 'a' && typeof attributes.href === 'string' && attributes.href.startsWith('/')) attributes.href = new URL(attributes.href, SITE_CONFIG.baseUrl).href;
if (Tag === 'img' && typeof attributes.src === 'string' && attributes.src.startsWith('/')) attributes.src = new URL(attributes.src, SITE_CONFIG.baseUrl).href;
---
<Tag {...attributes} class={className || attributes.class} style={style || inlineStyle}><slot /></Tag>
