---
interface Props { id: string; title?: string }
const { id, title = 'YouTube video player' } = Astro.props;
---
<div style="margin:32px 0">
  <a href={`https://www.youtube.com/watch?v=${encodeURIComponent(id)}`} style="color:#fff;text-decoration:underline;text-decoration-color:#fff;text-underline-offset:2px;text-decoration-thickness:1px">Watch: {title}</a>
</div>
