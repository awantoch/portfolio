---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import OrthodoxCrosses from '../components/OrthodoxCrosses.astro';
import { SITE_CONFIG, METADATA_CONFIG, OG_CONFIG } from '../lib/constants';
interface Props {
  title?: string;
  pageTitle?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'profile' | 'article';
  publishedAt?: string;
  noindex?: boolean;
}
const { title = SITE_CONFIG.title, pageTitle: explicitPageTitle, description = SITE_CONFIG.description, image, type = 'website', publishedAt, noindex = false } = Astro.props;
const pageTitle = explicitPageTitle || (title === SITE_CONFIG.title ? title : `${title} | ${SITE_CONFIG.title}`);
const canonicalPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(canonicalPath, SITE_CONFIG.baseUrl).href;
const socialTitle = type === 'article' ? title : pageTitle;
const socialImage = image ? new URL(image, SITE_CONFIG.baseUrl).href : `${SITE_CONFIG.baseUrl}/og?${new URLSearchParams({ title: socialTitle, description })}`;
const socialImagePath = new URL(socialImage).pathname.toLowerCase();
const socialImageType = socialImagePath.endsWith('.jpg') || socialImagePath.endsWith('.jpeg')
  ? 'image/jpeg'
  : socialImagePath.endsWith('.webp') ? 'image/webp' : 'image/png';
const websiteData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_CONFIG.baseUrl}/#website`,
  url: `${SITE_CONFIG.baseUrl}/`,
  name: SITE_CONFIG.title,
  description: SITE_CONFIG.description,
  inLanguage: SITE_CONFIG.language,
};
---
<!doctype html>
<html lang={SITE_CONFIG.language} class="text-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={METADATA_CONFIG.author} />
    <meta name="creator" content={METADATA_CONFIG.author} />
    <meta name="publisher" content={METADATA_CONFIG.author} />
    <meta name="format-detection" content="telephone=no, address=no, email=no" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="googlebot" content={noindex ? 'noindex, follow' : 'index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1'} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_CONFIG.title} — Journal`} href={`${SITE_CONFIG.baseUrl}/rss`} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" type="image/png" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_CONFIG.title} />
    <meta property="og:locale" content={SITE_CONFIG.locale} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content={socialImageType} />
    <meta property="og:image:width" content={String(OG_CONFIG.imageWidth)} />
    <meta property="og:image:height" content={String(OG_CONFIG.imageHeight)} />
    <meta property="og:image:alt" content={socialTitle} />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:creator" content={METADATA_CONFIG.twitterHandle} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialTitle} />
    <meta name="theme-color" content="#120c18" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteData).replace(/</g, '\\u003c')} />
    <slot name="head" />
  </head>
  <body class="antialiased text-white overflow-hidden">
    <OrthodoxCrosses mode="fullscreen" />
    <div id="site-scroll" class="fixed inset-0 overflow-y-auto" style="z-index: 0; -webkit-overflow-scrolling: touch;">
      <main class="min-h-screen w-full flex flex-col items-center mt-4">
        <div class="w-full max-w-xl px-4">
          <Navbar />
          <slot />
          <Footer />
        </div>
      </main>
      <Analytics />
    </div>
  </body>
</html>
